{% use "@Contao/component/_company_country.html.twig" %}
{% block company_address_component %}
    <ul class="company__address">
        {% if attribute(group, 'street') | default %}
            <li class="company__street">
                <span>{{ attribute(group, 'street') }}</span>
            </li>
        {% endif %}
        <li class="company__location">
            {% if attribute(group, 'postal') | default %}<span>{{ attribute(group, 'postal') }}</span>{% endif %}
            {% if attribute(group, 'city') | default %}<span>{{ attribute(group, 'city') }}</span>{% endif %}
        </li>
        {{ block('company_country_component') }}
    </ul>
{% endblock %}