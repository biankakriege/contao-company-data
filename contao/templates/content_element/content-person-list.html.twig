{% use "@Contao/component/_figure.html.twig" %}
{% use "@Contao/component/_company_contact.html.twig" %}

<div class="person" itemscope itemtype="http://schema.org/Person">
    {% block bk_image %}
        {% if image|default %}
            {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
        {% endif %}
    {% endblock %}

    {% block bk_name %}
        <div class="person__content">
            {% if title|default %} {% set name = title ~ ' ' ~ name %}{% endif %}
            {% if name|default %}<span class="person__name">{{ name }}</span>{% endif %}
            {% if companyName|default %}<span class="company__name">{{ companyName }}</span>{% endif %}
            {% if position|default %}<span>{{ position }}</span>{% endif %}
        </div>
    {% endblock %}

    {% block bk_email %}
        {% if email|default %}
            <div class="person__content">
                <span class="label">{{ attribute(attribute(translation, 'email' ),0) }}</span>
                <span class="value">{{ email }}</span>
            </div>
        {% endif %}
    {% endblock %}

    {% block bk_contact %}
        {% if phone|default or mobile|default or fax|default %}
        <div class="person__content">
            {% if phone|default %}
                <span class="label">{{ attribute(attribute(translation, 'phone' ),0) }}</span>
                <a href="tel:{{ phoneFormatted }}" class="value" title="{{ phone }}">{{ phone }}</a>
            {% endif %}
            {% if mobile|default %}
                <span class="label">{{ attribute(attribute(translation, 'mobile' ),0) }}</span>
                <span class="value">{{ mobile }}</span>
            {% endif %}
            {% if fax|default %}
                <span class="label">{{ attribute(attribute(translation, 'fax' ),0) }}</span>
                <span class="value">{{ fax }}</span>
            {% endif %}
        </div>
        {% endif %}
    {% endblock %}

    {% block bk_address %}
        {% if street|default or postal|default or city|default or country|default %}
        <div class="person__content">
            {% if street|default %}
                <span>{{ street }}</span>
            {% endif %}
            <div class="person__address">
                {% if postal|default %}
                    <span>{{ postal }}</span>
                {% endif %}
                {% if city|default %}
                    <span class="city">{{ city }}</span>
                {% endif %}
            </div>
            {% if country|default %}
                <span class="country">{{ country }}</span>
            {% endif %}
        </div>
        {% endif %}
    {% endblock %}

    {% block bk_office %}
        {% if officeHours|default %}
        {% set rows = officeHours|filter(row => row.value is not empty) %}

        {% if rows is not empty %}
            <dl class="person__content opening-hours">
                {% for row in rows %}
                    <dt class="opening-hours-day">{{ row.key }}</dt>
                    <dd class="opening-hours-time">{{ row.value }}</dd>
                {% endfor %}
            </dl>
        {% endif %}
        {% endif %}
    {% endblock %}

    {% block bk_href %}
        {% if href|default %}
            <a href="{{ href }}" title="{{ href_title }}">{{ href_text }}</a>
        {% endif %}
    {% endblock %}
</div>